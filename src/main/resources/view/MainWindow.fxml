<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="420.0"
            style="-fx-background-color: #0e1621;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="carl.ui.MainWindow">
    <children>
        <!-- Top Accent Banner -->
        <HBox alignment="CENTER_LEFT"
              prefHeight="52.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0"
              style="-fx-background-color: #17212b; -fx-border-color: transparent transparent #242f3d transparent; -fx-border-width: 1;">
            <padding>
                <Insets left="16.0" right="16.0" />
            </padding>
            <children>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <Label text="Chatting with Carl"
                               style="-fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', 'Helvetica Neue', Arial;" />
                        <Label text="bot"
                               style="-fx-text-fill: #7f8b99; -fx-font-size: 11.5px;" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Chat Area with Telegram Pattern Background -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    hvalue="1.0"
                    vvalue="1.0"
                    AnchorPane.topAnchor="52.0"
                    AnchorPane.bottomAnchor="60.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    style="-fx-background: transparent; -fx-background-color: #0e1621; -fx-background-image: url('/images/telegram-bg.jpeg'); -fx-background-repeat: repeat; -fx-background-size: 600px auto; -fx-border-color: transparent;">
            <content>
                <VBox fx:id="dialogContainer"
                      spacing="10.0"
                      style="-fx-background-color: transparent;">
                    <padding>
                        <Insets bottom="12.0" left="10.0" right="10.0" top="12.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <!-- Input Bar -->
        <HBox alignment="CENTER"
              spacing="8.0"
              prefHeight="60.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              style="-fx-background-color: #17212b; -fx-border-color: #242f3d transparent transparent transparent; -fx-border-width: 1;">
            <padding>
                <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
            </padding>
            <children>
                <TextField fx:id="userInput"
                           HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput"
                           promptText="Write a message..."
                           style="-fx-background-color: #242f3d; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #7f8b99; -fx-background-radius: 20; -fx-padding: 8 14 8 14; -fx-font-size: 13.5px;" />
                <Button fx:id="sendButton"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        prefHeight="36.0"
                        prefWidth="36.0"
                        minWidth="36.0"
                        text="➤"
                        style="-fx-background-color: #5288c1; -fx-text-fill: white; -fx-background-radius: 18; -fx-font-size: 13px; -fx-cursor: hand;" />
            </children>
        </HBox>
    </children>
</AnchorPane>