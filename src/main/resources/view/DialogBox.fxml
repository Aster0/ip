<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         spacing="8.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog"
               text="Label"
               wrapText="true"
               minHeight="-Infinity"
               maxWidth="290.0"
               style="-fx-background-color: #2b5278; -fx-text-fill: #ffffff; -fx-background-radius: 12px; -fx-padding: 8px 12px 8px 12px; -fx-font-size: 13.5px; -fx-line-spacing: 2px;" />
        <ImageView fx:id="displayPicture"
                   fitHeight="38.0"
                   fitWidth="38.0"
                   pickOnBounds="true"
                   preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="3.0" left="6.0" right="6.0" top="3.0" />
    </padding>
</fx:root>